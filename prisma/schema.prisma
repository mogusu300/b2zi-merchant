generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MerchantHunter {
  id                        String                   @id
  email                     String                   @unique
  phone                     String                   @unique
  firstName                 String
  lastName                  String
  password                  String
  region                    String?
  managerId                 String?
  isActive                  Boolean                  @default(true)
  lastLoginAt               DateTime?
  lastLoginIp               String?
  targetMonthly             Int                      @default(0)
  onboardedCount            Int                      @default(0)
  rejectedCount             Int                      @default(0)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime
  agent_performance_metrics AgentPerformanceMetric[]
  agent_targets             AgentTarget[]
  merchant_activity_logs    MerchantActivityLog[]
  merchant_hunter_merchants MerchantHunterMerchant[]

  @@index([email])
  @@index([isActive])
  @@index([phone])
  @@map("merchant_hunters")
}

model MerchantHunterMerchant {
  id                    String         @id
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  merchantHunterId      String
  merchantId            String
  onboardingDaysElapsed Int            @default(0)
  onboardingStartedAt   DateTime       @default(now())
  status                String         @default("not_started")
  updatedAt             DateTime
  merchant_hunters      MerchantHunter @relation(fields: [merchantHunterId], references: [id], onDelete: Cascade)
  merchants             merchants      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantHunterId, merchantId])
  @@index([merchantHunterId])
  @@index([merchantId])
  @@index([status])
  @@map("merchant_hunter_merchants")
}

model MerchantOnboardingDocument {
  id                 String    @id
  createdAt          DateTime  @default(now())
  documentType       String
  extractedData      Json?
  fileName           String
  fileSize           Int
  fileUrl            String
  isVerified         Boolean   @default(false)
  merchantId         String
  mimeType           String
  ocrConfidence      Float?
  updatedAt          DateTime
  uploadedAt         DateTime  @default(now())
  uploadedByHunterId String?
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedByAdminId  String?
  merchants          merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([documentType])
  @@index([isVerified])
  @@index([merchantId])
  @@map("merchant_onboarding_documents")
}

model MerchantActivityLog {
  metadata             Json?
  id                   String          @id
  action               String
  createdAt            DateTime        @default(now())
  description          String
  merchantHunterId     String?
  merchantId           String
  performedByIp        String?
  performedByRole      String
  performedByUserAgent String?
  merchant_hunters     MerchantHunter? @relation(fields: [merchantHunterId], references: [id])
  merchants            merchants       @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([merchantHunterId])
  @@index([merchantId])
  @@map("merchant_activity_logs")
}

model AgentTarget {
  id               String         @id
  createdAt        DateTime       @default(now())
  createdByAdminId String?
  merchantHunterId String
  month            Int
  targetCount      Int
  updatedAt        DateTime
  year             Int
  merchant_hunters MerchantHunter @relation(fields: [merchantHunterId], references: [id], onDelete: Cascade)

  @@unique([merchantHunterId, year, month])
  @@index([merchantHunterId])
  @@map("agent_targets")
}

model AgentPerformanceMetric {
  id                    String         @id
  averageOnboardingDays Float          @default(0)
  calculatedAt          DateTime?
  conversionRate        Float          @default(0)
  createdAt             DateTime       @default(now())
  isCalculated          Boolean        @default(false)
  merchantHunterId      String
  month                 Int
  totalOnboarded        Int            @default(0)
  totalPending          Int            @default(0)
  totalRejected         Int            @default(0)
  updatedAt             DateTime
  year                  Int
  merchant_hunters      MerchantHunter @relation(fields: [merchantHunterId], references: [id], onDelete: Cascade)

  @@unique([merchantHunterId, year, month])
  @@index([merchantHunterId])
  @@map("agent_performance_metrics")
}

model MerchantLogin {
  id            String    @id
  createdAt     DateTime  @default(now())
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  lockoutUntil  DateTime?
  loginAttempts Int       @default(0)
  merchantId    String    @unique
  otpEnabled    Boolean   @default(false)
  password      String?
  phone         String    @unique
  updatedAt     DateTime
  verifiedAt    DateTime?
  merchants     merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([phone])
  @@map("merchant_logins")
}

model admin_users {
  id          String    @id
  email       String    @unique
  password    String
  name        String
  role        AdminRole
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  @@index([email])
  @@index([role])
}

model customers {
  id            String     @id
  email         String     @unique
  name          String
  password      String
  phone         String?
  isVerified    Boolean    @default(false)
  lastLogin     DateTime?
  loginAttempts Int        @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  orders        orders[]
  sessions      sessions[]

  @@index([email])
}

model merchants {
  id                            String                       @id
  businessName                  String
  ownerName                     String
  email                         String                       @unique
  phone                         String
  businessType                  String?
  businessAddress               String?
  password                      String
  idType                        String
  idFrontUrl                    String?
  idBackUrl                     String?
  status                        String                       @default("pending")
  isVerified                    Boolean                      @default(false)
  lastLogin                     DateTime?
  loginAttempts                 Int                          @default(0)
  lockedUntil                   DateTime?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime
  merchant_activity_logs        MerchantActivityLog[]
  merchant_hunter_merchants     MerchantHunterMerchant[]
  merchant_logins               MerchantLogin?
  merchant_onboarding_documents MerchantOnboardingDocument[]
  products                      products[]
  sessions                      sessions[]

  @@index([email])
}

model orders {
  id         String    @id
  customerId String
  total      Float
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  customers  customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model products {
  id          String    @id
  name        String
  description String
  price       Float
  category    String
  images      String[]
  sellerId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  merchants   merchants @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model refresh_tokens {
  id           String     @id
  token        String     @unique
  type         TokenType
  entityId     String
  entityType   EntityType
  expiresAt    DateTime
  revokedAt    DateTime?
  isValid      Boolean    @default(true)
  issuedAt     DateTime   @default(now())
  issuedFromIp String?
  userAgent    String?
  createdAt    DateTime   @default(now())

  @@index([entityId, entityType])
  @@index([expiresAt])
  @@index([token])
}

model sessions {
  id         String     @id
  token      String     @unique
  type       String
  userId     String
  merchantId String?
  customerId String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  customers  customers? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchants  merchants? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@index([merchantId])
  @@index([token])
  @@index([userId])
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
  MANAGER
}

enum EntityType {
  HUNTER
  MERCHANT
}

enum TokenType {
  ACCESS
  REFRESH
}
